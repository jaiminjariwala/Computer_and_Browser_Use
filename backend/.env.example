PORT=8787
PUBLIC_APP_URL=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgres://postgres:postgres@localhost:55432/computer_browser_use?sslmode=disable

# Browser OAuth: secret stays on the Go server, never in Electron.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://127.0.0.1:8787/v1/auth/github/callback

# Set both to enable our custom checkout; leave empty for hosted Stripe Checkout.
STRIPE_PUBLISHABLE_KEY=
CHECKOUT_URL=

# Server-owned model credentials. Never ship these in Electron.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# No paid OpenAI fallback is used in this edition.
# Keep GEMINI_API_KEY on a Free Tier project; the app cannot change Google billing.

# Product allowance units. The first version charges one unit per model token.
FREE_MONTHLY_UNITS=50000
PLUS_MONTHLY_UNITS=2000000

# Stripe test-mode values. PLUS_PRICE_ID must be an active USD $1/month price.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CANCEL_URL=http://localhost:5173/billing/cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:5173
